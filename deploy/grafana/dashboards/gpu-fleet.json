        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "refId": "A",
          "expr": "count(gpu_agent_gpu_healthy == 0) or vector(0)",
          "legendFormat": "unhealthy",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Attestation failures (24h)",
      "description": "Nodes that failed tenant attestation over the last 24 hours. Each one is quarantined as attestation_failed.",
